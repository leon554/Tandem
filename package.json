{
  "name": "foodtracker",
  "private": true,
  "workspaces": [
    "mobile",
    "api"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,mobile -c blue,magenta \"npm run dev:backend\" \"npm run start -w mobile\"",
    "dev:backend": "docker compose up --build",
    "down": "docker compose down",
    "db:generate": "npm run db:generate -w api",
    "db:studio": "npm run db:studio -w api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
